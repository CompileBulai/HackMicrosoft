# Copy to .env and fill in. Never commit .env.

# --- Azure AI Speech --------------------------------------------------------
# Used by both flows: transcription (hearing) and neural voices (vocal).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- Azure AI Foundry -------------------------------------------------------
# Used by the shared text helper in services/foundry.py.
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
